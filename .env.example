# Hardhat 3 configuration variables — these are NOT read from .env.
# Set them via the encrypted keystore, e.g.:
#   pnpm hardhat keystore set AMOY_RPC_URL
#   pnpm hardhat keystore set AMOY_PRIVATE_KEY
#   pnpm hardhat keystore set ETHERSCAN_API_KEY

# Polygon Amoy RPC endpoint (public default shown; any Amoy RPC works)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of the deployer/issuer wallet on Polygon Amoy (needs test POL)
AMOY_PRIVATE_KEY=

# Polygonscan/Etherscan API key (v2 unified API) for `hardhat verify`
ETHERSCAN_API_KEY=
