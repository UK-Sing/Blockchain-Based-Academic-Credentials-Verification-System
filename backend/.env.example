# --- Database ---
DATABASE_URL=postgresql://credential_user:credential_pass@localhost:5432/credential_chain?schema=public

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# --- Blockchain ---
# Local Hardhat node default RPC. Leave as-is for local demo mode.
RPC_URL=http://127.0.0.1:8545
# Local Hardhat account #0 private key (well-known, safe only for local dev).
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ADDRESS=
CHAIN_ID=31337
NETWORK_LABEL=Hardhat Local

# --- Polygon Amoy (testnet) alternative ---
# RPC_URL=https://rpc-amoy.polygon.technology
# BLOCKCHAIN_PRIVATE_KEY=<funded Amoy wallet that OWNS the deployed contract — never commit>
# CONTRACT_ADDRESS=<address printed by `pnpm run deploy:amoy` at repo root>
# CHAIN_ID=80002
# NETWORK_LABEL=Polygon Amoy Testnet

# --- App ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
